# Supabase → botón "Connect" en la barra superior del panel del proyecto →
# sección "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DJANGO_SECRET_KEY=cambiame-en-produccion
DJANGO_DEBUG=1

# Correo saliente (invitaciones a miembros). Gmail: activa la verificación en
# 2 pasos → "Contraseñas de aplicaciones" → crea una para Wealthome y pégala
# aquí. Sin EMAIL_HOST_USER los correos se imprimen en la terminal.
EMAIL_HOST_USER=tu.cuenta@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=Wealthome <tu.cuenta@gmail.com>

# --- Produccion (en desarrollo local no hace falta ninguna) ---
# Los dominios que sirven la aplicacion, separados por comas. Django contesta
# 400 a cualquier Host que no este aqui, y de esta lista se derivan tambien los
# CSRF_TRUSTED_ORIGINS.
DJANGO_ALLOWED_HOSTS=wealthome.site,www.wealthome.site

# 0 cierra /signup/ (contesta 404): el hogar lo crea el administrador una vez y
# el resto entra por invitacion. Es lo adecuado en un piloto privado.
DJANGO_REGISTRO_ABIERTO=0

# Pago (§5). Vacias, el boton de pagar avisa en vez de reventar; pero pasados
# los 14 dias de prueba el hogar queda en solo lectura.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
