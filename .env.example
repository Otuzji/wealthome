# Supabase → botón "Connect" en la barra superior del panel del proyecto →
# sección "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DJANGO_SECRET_KEY=cambiame-en-produccion
DJANGO_DEBUG=1

# Correo saliente (invitaciones a miembros). Gmail: activa la verificación en
# 2 pasos → "Contraseñas de aplicaciones" → crea una para Wealthome y pégala
# aquí. Sin EMAIL_HOST_USER los correos se imprimen en la terminal.
EMAIL_HOST_USER=tu.cuenta@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=Wealthome <tu.cuenta@gmail.com>
